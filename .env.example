# Inquiry submissions stay off until a real delivery provider is configured.
# This is a server-only variable. Do not prefix it with NEXT_PUBLIC_.
INQUIRY_SUBMISSIONS_ENABLED=false

# Comma-separated browser origins allowed to call POST /api/inquiries.
# Do not list localhost here. Local development origins are allowed only when NODE_ENV=development.
# INQUIRY_TRUSTED_ORIGINS=https://levelup-digital.dev

# Secret used to hash rate-limit keys. At least 16 characters. Server-only.
# INQUIRY_RATE_LIMIT_KEY_SECRET=replace-with-a-long-random-string

# Brevo transactional email. Server-only. An API key does not enable inquiry submissions.
# The sender must be verified in Brevo before any live send. Do not put a real key in this file.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=levelupdigital.support@gmail.com
BREVO_SENDER_NAME=LevelUp Digital
INQUIRY_NOTIFICATION_EMAIL=levelupdigital.support@gmail.com

# Upstash Redis REST. Server-only. These values do not enable inquiry submissions.
# Live checks, both separate from npm test:
# npm run test:upstash
# npm run test:inquiry-pipeline
# UPSTASH_REDIS_REST_URL=https://example.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# Secret used to hash Idempotency-Key values. At least 16 characters. Do not reuse the rate-limit secret.
# INQUIRY_IDEMPOTENCY_KEY_SECRET=replace-with-a-different-long-random-string
